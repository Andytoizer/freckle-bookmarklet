{
  "manifest_version": 3,
  "name": "Send to Freckle",
  "version": "0.1.0",
  "description": "Send the page you're on to one of your organization's Freckle workflows.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Send to Freckle",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://next-api.freckle.io/*"],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["https://www.linkedin.com/*"],
  "commands": {
    "send-current-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Send the current page to its default workflow"
    }
  }
}
